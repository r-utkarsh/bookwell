# Bookwell backend environment template.
# Spring Boot does not load this file automatically. Export these values in
# your shell/IDE, or configure them in your hosting provider's dashboard.
# See README.md for PowerShell and Bash examples.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
APP_ENV=dev
PORT=8080
# A JDBC URL or a hosted postgres:// / postgresql:// URI.
DB_URL=jdbc:postgresql://localhost:5432/bookwell
DB_USERNAME=bookwell
DB_PASSWORD=bookwell
DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Authentication and browser security
# ---------------------------------------------------------------------------
# Leave blank in development for an ephemeral key. Production requires a
# Base64 value that decodes to at least 32 bytes: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P14D
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_DOMAIN=
# Comma-separated exact origins. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_FORWARDED_HEADERS=false
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Booking policy
# ---------------------------------------------------------------------------
DEFAULT_TIME_ZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
BOOKING_START_INTERVAL_MINUTES=30
CANCELLATION_CUTOFF=PT2H
BOOKING_MIN_LEAD_TIME=PT30M
BOOKING_MAX_ADVANCE_DAYS=60

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# LOG prints messages to the application log and marks them SENT with
# delivery_mode=LOG. Production requires SMTP.
NOTIFICATIONS_ENABLED=true
NOTIFICATION_WORKER_ENABLED=true
MAIL_MODE=log
REMINDER_LEAD_TIME=PT24H
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_POLL_INTERVAL_MS=30000
MAIL_FROM=no-reply@bookwell.local
MAIL_FROM_NAME=Bookwell
APP_PUBLIC_URL=http://localhost:5173
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_AUTH=true

# ---------------------------------------------------------------------------
# Demo seed data (development only; rejected when APP_ENV=production)
# ---------------------------------------------------------------------------
SEED_ENABLED=false
SEED_ADMIN_EMAIL=admin@bookwell.demo
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Platform Administrator
SEED_PROVIDER_EMAIL=aarohi@bookwell.demo
SEED_PROVIDER_PASSWORD=
SEED_CUSTOMER_EMAIL=riya@bookwell.demo
SEED_CUSTOMER_PASSWORD=

# ---------------------------------------------------------------------------
# One-time administrator bootstrap (safe in any environment)
# Set both values, start the application once, verify sign-in, then remove.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Administrator
