# Frontend environment template.
# Copy to .env.local for local overrides. Vite only exposes VITE_* variables.
#
# Leave blank during local development so requests go to /api and Vite proxies
# them to http://localhost:8080.
VITE_API_BASE_URL=

# Production example:
# VITE_API_BASE_URL=https://bookwell-api.onrender.com
